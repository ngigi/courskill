NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
NEXT_PUBLIC_SITE_URL=https://YOUR-COURSKILLS.vercel.app

# Stripe card payments — USD 10 fixed fee.
STRIPE_ENABLED=true
PAYMENT_PROVIDER_SECRET=sk_test_...
PAYMENT_WEBHOOK_SECRET=whsec_...

# M-Pesa Daraja STK Push — KES 1,200 fixed fee for Kenyan learners.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=YOUR_DARAJA_CONSUMER_KEY
MPESA_CONSUMER_SECRET=YOUR_DARAJA_CONSUMER_SECRET
MPESA_SHORTCODE=YOUR_SHORTCODE
MPESA_PASSKEY=YOUR_STK_PASSKEY
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_URL=https://YOUR-COURSKILLS.vercel.app/api/payments/mpesa/callback
